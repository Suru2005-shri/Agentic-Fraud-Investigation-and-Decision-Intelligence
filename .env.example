# Copy to .env and export these before starting the server (or pass them to Docker).
ARGUS_SECRET=change-me-to-a-long-random-string
ARGUS_DB=./data/argus.db
# Seconds the agent pauses between steps so the interface can show the case as it progresses. 0 = instant.
ARGUS_STEP_DELAY=0.8
# Evidence sufficiency threshold in percent.
ARGUS_THRESHOLD=85
ARGUS_TOKEN_HOURS=8
